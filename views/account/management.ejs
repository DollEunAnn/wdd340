<% if (title) { %>
    <h1>
        <%= title %>
    </h1>
    <% } else { res.redirect('/') } %>

        <!-- message -->
        <%- messages() %>


            <% if (errors) { %>
                <ul class="notice">
                    <% errors.array().forEach(error=> { %>
                        <li>
                            <% error.msg %>
                        </li>
                        <% }) %>
                </ul>
                <% } %>

                    <h2>
                        Welcome <%= locals.accountData.account_firstname %> !
                    </h2>

                    <!-- Update Account Link (FOR ALL USERS) -->
                    <p>
                        <a href="/account/update/<%= locals.accountData.account_id %>">
                            Update Account Information
                        </a>
                    </p>

                    <% if ( locals.accountData.role_id===2 || locals.accountData.role_id===3 ) { %>
                        <div class="borderBox">

                            <h3>Inventory Management</h3>

                            <p>
                                <a href="/inv/">
                                    Manage Inventory
                                </a>
                            </p>
                        </div>

                        <% } %>


                            <% if ( locals.accountData.role_id===3 ) { %>

                                <div class="borderBox">
                                    <h3>User Management</h3>

                                    <p>
                                        <a href="/account/user-management">
                                            Manage Users
                                        </a>
                                    </p>
                                </div>

                                <% } %>


                                    <% if ( locals.accountData.role_id===3 ) { %>

                                        <div class="borderBox">
                                            <h3>Role Management</h3>

                                            <p>
                                                <a href="/account/role-management">
                                                    Manage Roles
                                                </a>
                                            </p>
                                        </div>

                                        <% } %>