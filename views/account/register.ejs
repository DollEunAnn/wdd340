<% if (title) { %>
    <h1>
        <%= title %>
    </h1>
    <% } else { res.redirect('/') } %>

        <!-- message -->
        <%- messages() %>

            <% if (errors) { %>
                <ul class="notice">
                    <% errors.array().forEach(error=> { %>
                        <li>
                            <%= error.msg %>
                        </li>
                        <% }) %>
                </ul>
                <% } %>

                    <!-- Login Form -->
                    <div class="container">
                        <div>
                            <form action="/account/register" method="post">
                                <div class="formItem">
                                    <label for="account_firstname">First name:</label>
                                    <input type="text" name="account_firstname" id="account_firstname" required
                                        value="<%= locals.account_firstname %>">
                                </div>
                                <div class="formItem">
                                    <label for="account_lastname">Last name:</label>
                                    <input type="text" name="account_lastname" id="account_lastname" required
                                        value="<%= locals.account_lastname %>">
                                </div>
                                <div class="formItem">
                                    <label for="account_email">Email:</label>
                                    <input type="email" name="account_email" id="account_email" required
                                        value="<%= locals.account_email %>" placeholder="Enter a valid email address">
                                </div>
                                <!-- 12 char, 1 capital, 1 number, 1 special char -->
                                <div class="formItem">
                                    <label for="account_password">Password:</label>
                                    <input type="password" name="account_password" id="pword"
                                        pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
                                        required>
                                    <span id="pswdBtn">Show Password</span>
                                </div>

                                <div class="formButton">
                                    <button type="submit">Register</button>
                                </div>
                            </form>
                        </div>
                    </div>