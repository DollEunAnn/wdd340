<!-- Inventory Management - heading, message, inventory -->
<% if (title) { %>
    <h1>
        <%= title %>
    </h1>
    <% } else { res.redirect('/') } %>

        <!-- message -->
        <%- messages() %>

            <div class="container">
                <!-- add new classification -->
                <a href="/inv/add-classification">Add Classification</a>

                <!-- add new inventory item -->
                <a href="/inv/add-inventory-item">Add Inventory Item</a>
            </div>

            <h2>Manage Inventory</h2>
            <p>Choose a classification to view its inventory:</p>
            <%- classificationSelect %>

                <!-- table -->
                <table id="inventoryDisplay" class="stripedTable"></table>

                <noscript>JavaScript must be enabled to use this page.</noscript>

                <script src="../../js/inventory.js"></script>